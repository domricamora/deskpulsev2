# Disable directory listings (belt-and-braces; index.php handles routing anyway).
Options -Indexes

# Belt-and-braces security headers. bootstrap.php already emits these per-response
# (with request-aware HSTS); this is a fallback for static files served directly by
# the web server. LiteSpeed honors mod_headers. Inline styles/scripts are used
# heavily, so 'unsafe-inline' is intentionally kept for style-src/script-src.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
    # KEEP IN SYNC WITH the policy in src/bootstrap.php (send_security_headers).
    # .htaccess cannot read PHP, so this is a manual copy — change both or static files
    # end up on a different policy from pages.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com https://c.clarity.ms; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.clarity.ms https://c.bing.com; form-action 'self'"
    # HSTS only when the request arrived over HTTPS (live site); never on plain http/localhost.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
</IfModule>

# Route everything that isn't a real file/dir to the front controller.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Allow direct access to existing files and directories (assets, uploads).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    # Everything else -> index.php
    RewriteRule ^ index.php [L]
</IfModule>

# Never serve dotfiles (compatible with both Apache 2.4 and 2.2).
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
