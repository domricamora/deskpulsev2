# ─────────────────────────────── APP ───────────────────────────────
APP_NAME=DeskPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Production runs under a subdirectory-capable layout; keep the trailing path
# if you are serving from http://localhost/deskpulsev2/public.
APP_URL=http://localhost/deskpulsev2/public

# All datetimes are stored and computed in UTC. Reporting windows are cut in the
# organization's own report_tz, and display happens in the viewer's browser tz.
# Do NOT change this — see docs/migration/reports.md §1.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ───────────────────────────── LOGGING ─────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ──────────────────────────── DATABASE ─────────────────────────────
# The production host (z.com) serves PHP 8.3 only; composer.json pins the
# platform to match. MySQL/MariaDB, UTC throughout.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deskpulse
DB_USERNAME=root
DB_PASSWORD=

# Separate database for the test suite — never point this at the live schema.
DB_TEST_DATABASE=deskpulse_test

# ───────────────────── SESSION / CACHE / QUEUE ─────────────────────
# File/sync until Phase 3 lands the migrations that the database drivers need.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─────────────────────────────── MAIL ──────────────────────────────
# The legacy app queues everything through an outbox and drains it from cron,
# with one exception: password resets send synchronously.
# See docs/migration/messaging.md.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ───────────────────────────── DESKPULSE ───────────────────────────
# Defaults only. Per-organization values live on the organizations row and
# override these — see docs/migration/monitoring.md §1.
DESKPULSE_IDLE_THRESHOLD_MIN=15
DESKPULSE_SYNC_INTERVAL_S=60
DESKPULSE_STALE_SESSION_MIN=15

# ─────────────────────────────── AGENT ─────────────────────────────
# The desktop agent is frozen on /webhooks/* with HMAC-SHA256 over the raw
# request body. Do not introduce a versioned prefix for it.
# See docs/migration/api-contract.md.
AGENT_WEBHOOK_PREFIX=webhooks

# ──────────────────────────── SCREENSHOTS ──────────────────────────
# Retention is platform-wide (0 = keep forever). Capture interval and blur are
# per-organization. See docs/migration/screenshots.md.
SCREENSHOT_RETENTION_DAYS=30
SCREENSHOT_INTERVAL_MIN=10
SCREENSHOT_DISK=private

# ─────────────────────── REMOTE CONTROL LIMITS ─────────────────────
# Server-enforced containment. Changing these widens the window in which an
# abandoned control session stays live — see docs/migration/remote-control.md §2.
REMOTE_AGENT_TIMEOUT_S=15
REMOTE_IDLE_MAX_S=600
REMOTE_PENDING_TIMEOUT_S=30

# ────────────────────────────── VITE ───────────────────────────────
VITE_APP_NAME="${APP_NAME}"
